# LINGUAVERSE AI — Cloudflare Wrangler Local Secrets Template
# Copy this file to `.dev.vars` for local `npx wrangler dev` execution.
# NEVER commit `.dev.vars` or real credentials to Git!

# Required for AI features in local Worker testing
GEMINI_API_KEY=

# Required for Worker JWT signing (min 32 random chars in staging/production)
JWT_SIGNING_SECRET=replace-with-32-plus-character-random-secret-key

# Required in production for one-time initial Super Admin bootstrap (min 16 chars)
ADMIN_BOOTSTRAP_SECRET=replace-with-16-plus-char-bootstrap-secret

# Strict CORS origin allowlist (comma-separated origins, no wildcard *)
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional transactional email delivery (Resend or Brevo; local dev preview active when blank)
RESEND_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LINGUAVERSE AI <noreply@yourdomain.com>"

# Optional Google OAuth 2.0 credentials (stays honestly disabled until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional payment gateway webhook signing secrets (fail-closed 503 until set)
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_PASSWD=
PADDLE_WEBHOOK_SECRET=

# Optional modular AI / Speech / Turnstile integrations (awaiting credentials until set)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TURNSTILE_SECRET_KEY=
