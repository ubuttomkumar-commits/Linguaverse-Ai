# LINGUAVERSE AI — Environment Variables Template (NEVER commit real secrets)

# Server-side Gemini API key for AI Speaking Studio, Transfer Lab, and Landing Sandbox
GEMINI_API_KEY=

# Transactional email provider for 6-digit OTP verification & password reset emails (Resend or Brevo)
RESEND_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LINGUAVERSE AI <noreply@linguaverse.ai>"

# Optional Google OAuth 2.0 credentials (Google Sign-In remains disabled until configured on the server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Worker JWT signing secret (generate a 32+ byte random string)
JWT_SIGNING_SECRET=

# Optional frontend API base URL (set to deployed Cloudflare Worker URL in production)
# Leave blank for local Vite + Express dev server mode
VITE_API_BASE_URL=

# Optional payment gateway webhook signing secrets (keep blank until merchant gateway is active)
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_PASSWD=
PADDLE_WEBHOOK_SECRET=

# Optional modular AI / Speech / Pronunciation / Bot-protection providers (awaiting credentials until set)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TURNSTILE_SECRET_KEY=

# One-time initial Super Admin provisioning secret for the separate Admin Application (required in production, min 16 chars)
ADMIN_BOOTSTRAP_SECRET=
# Set to "true" ONLY when running behind a trusted reverse proxy that overwrites X-Forwarded-For / CF-Connecting-IP.
TRUST_PROXY=
