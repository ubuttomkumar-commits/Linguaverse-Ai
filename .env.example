# GEMINI_API_KEY: Required for Gemini AI API calls in future voice/feedback phases.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional Cloudflare Workers + D1 API base URL (e.g., https://api.linguaverse.ai).
# Leave empty to use local browser persistence during Phase 1 development.
VITE_API_BASE_URL=""
