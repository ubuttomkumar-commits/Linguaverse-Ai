# LINGUAVERSE AI — Environment Variables Template (NEVER commit real secrets)

# Server-side Gemini API key for AI Speaking Studio, Transfer Lab, and Landing Sandbox
GEMINI_API_KEY=

# Transactional email provider for Gmail 6-digit OTP verification (Resend or Brevo)
RESEND_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LINGUAVERSE AI <noreply@linguaverse.ai>"

# Cloudflare Worker JWT signing secret (generate a 32+ byte random string)
JWT_SIGNING_SECRET=

# Optional frontend API base URL (set to deployed Cloudflare Worker URL in production)
# Leave blank for local Vite + Express dev server mode
VITE_API_BASE_URL=